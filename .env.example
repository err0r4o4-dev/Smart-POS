# =============================================================================
# SmartPOS - ค่าตั้งสำหรับรันบนเครื่อง (LOCAL DEVELOPMENT ONLY)
# ค่าทั้งหมดในไฟล์นี้ใช้กับเครื่อง dev เท่านั้น ห้ามนำไปใช้ใน production
# ไม่มี secret จริง รหัสผ่านด้านล่างเป็นค่าสำหรับทดลองในเครื่อง
#
# วิธีใช้:  คัดลอกไฟล์นี้เป็น .env แล้วรัน  docker compose up --build
# เปิดเว็บ: http://localhost:8088
# =============================================================================

# ===== Application =====
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8088
DEV_ORIGINS=http://localhost:5173

# ===== Ports =====
# ถ้าพอร์ตชนกับโปรแกรมอื่นในเครื่อง ให้เปลี่ยนเลขพอร์ตตรงนี้
# ถ้าเปลี่ยน GATEWAY_PORT / WEB_PORT ต้องแก้ PUBLIC_ORIGIN / DEV_ORIGINS ให้ตรงกันด้วย
WEB_PORT=5173
API_PORT=8080
GATEWAY_PORT=8088
POSTGRES_PORT=5432
MAILPIT_PORT=8025

# ===== Database (PostgreSQL) =====
POSTGRES_DB=smartpos
POSTGRES_USER=smartpos_dev
POSTGRES_PASSWORD=local-development-only

# ===== Reverse proxy network (Caddy / API) =====
# ใช้ IP คงที่เพราะ API เชื่อ Caddy ตาม IP นี้เท่านั้น (ป้องกันการปลอม IP ผู้ใช้)
# แก้ได้เฉพาะเมื่อเจอ error "Pool overlaps with other one on this address space"
# ต้องแก้ทั้ง 3 ค่าพร้อมกัน และ IP ต้องอยู่ใน PROXY_SUBNET เช่น
#   PROXY_SUBNET=172.30.77.0/28
#   CADDY_PROXY_IP=172.30.77.2
#   API_PROXY_IP=172.30.77.3
PROXY_SUBNET=172.30.42.0/28
CADDY_PROXY_IP=172.30.42.2
API_PROXY_IP=172.30.42.3

# ===== Authentication =====
AUTH_SESSION_HOURS=24

# ===== Mail (SMTP / Mailpit) =====
# Mailpit เป็นกล่องจดหมายจำลองในเครื่อง ดูอีเมลที่ http://localhost:8025
SMTP_ADDR=mailpit:1025
MAIL_FROM=noreply@localhost
