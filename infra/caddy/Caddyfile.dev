{
	auto_https off
	admin off
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}
}
:8088 {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}
	log_append method {method}
	log_append path {orig_path}
	log_append request_id {http.response.header.X-Request-ID}
	log_append gateway_request_id {http.request.uuid}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://localhost:{$GATEWAY_PORT:8088} ws://127.0.0.1:{$GATEWAY_PORT:8088}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	@api path /api /api/* /health/*
	handle @api {
		reverse_proxy api:8080
	}
	@internal path /internal /internal/*
	handle @internal {
		respond "Not found" 404
	}
	handle {
		reverse_proxy web:5173
	}
}
