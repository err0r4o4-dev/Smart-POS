{
  "name": "smartpos",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @smartpos/web",
    "build": "npm run build --workspace @smartpos/web",
    "lint": "npm run lint --workspace @smartpos/web",
    "typecheck": "npm run typecheck --workspace @smartpos/web",
    "test": "npm run test --workspace @smartpos/web && npm run contracts:check",
    "contracts:check": "node scripts/check-contracts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs --tail 100",
    "migrate": "docker compose run --rm migrate",
    "verify:api": "docker compose --profile checks run --build --rm api-check",
    "verify:auth": "node tests/integration/auth-flow.mjs && node scripts/check-auth.mjs",
    "verify:organization": "node tests/integration/organization-flow.mjs",
    "verify:catalog": "node tests/integration/catalog-flow.mjs",
    "verify:inventory": "node tests/integration/inventory-flow.mjs",
    "verify:pos": "node tests/integration/pos-flow.mjs && node tests/integration/pos-safety.mjs",
    "verify:returns": "node tests/integration/returns-flow.mjs && node tests/integration/returns-safety.mjs && node tests/integration/returns-shelves.mjs",
    "verify:adjustments": "node tests/integration/adjustments-flow.mjs && node tests/integration/adjustments-safety.mjs && node tests/integration/adjustments-boundaries.mjs",
    "verify:phase52": "node scripts/check-phase52.mjs",
    "verify:pricing": "node tests/integration/pricing-flow.mjs && node tests/integration/pricing-safety.mjs",
    "verify:phase53": "node scripts/check-phase53.mjs",
    "verify:customers": "node tests/integration/customers-flow.mjs && node tests/integration/customers-safety.mjs",
    "verify:loyalty": "node tests/integration/loyalty-flow.mjs && node tests/integration/loyalty-safety.mjs",
    "verify:quality": "node tests/integration/quality-flow.mjs && node tests/integration/quality-safety.mjs",
    "verify:phase54": "node scripts/check-phase54.mjs",
    "verify:purchasing": "node tests/integration/purchasing-flow.mjs && node tests/integration/purchasing-safety.mjs",
    "verify:shelves": "node tests/integration/purchasing-flow.mjs && node tests/integration/purchasing-safety.mjs",
    "verify:ai": "docker compose --profile checks run --build --rm ai-check",
    "verify:integration": "docker compose --profile checks run --rm integration-check",
    "verify:resilience": "node scripts/check-resilience.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "3.9.9",
    "yaml": "2.9.1"
  }
}
